# Environment variables - copy this to .env and fill in your values

# ============================================================================
# GOOGLE OAUTH CONFIGURATION
# Get these from: https://console.cloud.google.com/
# ============================================================================
CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================
# Use a strong random string in production
SESSION_SECRET=change-this-to-a-strong-secret-in-production

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_URL=http://127.0.0.1:5173
REDIRECT_URI=http://localhost:8000/auth/callback

# ============================================================================
# LLM CONFIGURATION (Optional - system works without it)
# Get API key from: https://console.groq.com/
# ============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
FAISS_INDEX_PATH=data/faiss_index.bin
METADATA_PATH=data/metadata.json

# ============================================================================
# SEARCH CONFIGURATION
# ============================================================================
# Weights for hybrid search (must sum to 1.0 or close)
BM25_WEIGHT=0.3
FAISS_WEIGHT=0.7

# Default number of search results
DEFAULT_SEARCH_K=5
